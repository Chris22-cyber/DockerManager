<UserControl x:Class="DockerManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="500" Margin="24">

            <!-- Docker CLI -->
            <TextBlock Text="Docker CLI" FontSize="15" FontFamily="Segoe UI Semibold"
                       Foreground="{DynamicResource OnSurface}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource SurfaceLowest}" CornerRadius="10"
                    Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Percorso Docker CLI" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DockerCliPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}" Margin="0,0,0,8"/>
                    <Button Content="Verifica Docker" Command="{Binding TestDockerCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Registry -->
            <TextBlock Text="Registry Predefinito" FontSize="15" FontFamily="Segoe UI Semibold"
                       Foreground="{DynamicResource OnSurface}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource SurfaceLowest}" CornerRadius="10"
                    Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Server" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RegistryServer, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Username" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Padding="10,8" Margin="0,0,0,8"
                                 Background="{DynamicResource SurfaceContainerHigh}"
                                 BorderThickness="0"/>
                    <Button Content="Test Login" Command="{Binding TestLoginCommand}"
                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Save -->
            <Button Content="Salva Impostazioni" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Margin="0,4,0,12"/>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Primary}"
                       Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
