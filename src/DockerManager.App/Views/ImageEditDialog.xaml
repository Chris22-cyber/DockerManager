<Window x:Class="DockerManager.App.Views.ImageEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Immagine Docker" Height="520" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI">

    <DockPanel Margin="24">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annulla" Click="Cancel_Click"
                    Style="{StaticResource TertiaryButton}" Margin="4,0"/>
            <Button Content="Salva" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" Margin="4,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nome Immagine (identificativo)" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Percorso Dockerfile (relativo a Root Directory)"
                           Foreground="{DynamicResource OnSurfaceVariant}" FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Sfoglia" DockPanel.Dock="Right" Click="BrowseDockerfile_Click"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,8"/>
                    <TextBox Text="{Binding DockerfilePath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"/>
                </DockPanel>

                <TextBlock Text="Directory Contesto (relativa a Root Directory)"
                           Foreground="{DynamicResource OnSurfaceVariant}" FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Sfoglia" DockPanel.Dock="Right" Click="BrowseContext_Click"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,8"/>
                    <TextBox Text="{Binding ContextDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"/>
                </DockPanel>

                <TextBlock Text="Nome Immagine Docker (es. my-app-api)"
                           Foreground="{DynamicResource OnSurfaceVariant}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ImageName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Registry (es. docker.io/username)"
                           Foreground="{DynamicResource OnSurfaceVariant}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Registry, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="Tags" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PrimaryFixed}" CornerRadius="10"
                                    Padding="8,3" Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Primary}"
                                               VerticalAlignment="Center" FontSize="12"/>
                                    <Button Content="x" Margin="6,0,0,0" FontSize="10"
                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TertiaryButton}" Padding="2,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="Aggiungi" DockPanel.Dock="Right"
                            Command="{Binding AddTagCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,8"/>
                    <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
