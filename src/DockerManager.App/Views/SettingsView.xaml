<UserControl x:Class="DockerManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="500">
            <TextBlock Text="Impostazioni" FontSize="20" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,20"/>

            <!-- Docker CLI -->
            <TextBlock Text="Percorso Docker CLI" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DockerCliPath, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,0,0,4"/>
            <Button Content="Verifica Docker" Command="{Binding TestDockerCommand}"
                    Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,15"/>

            <!-- Registry -->
            <TextBlock Text="Registry Predefinito" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" Margin="0,10,0,10"/>

            <TextBlock Text="Server" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding RegistryServer, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,0,0,10"/>

            <TextBlock Text="Username" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,0,0,10"/>

            <TextBlock Text="Password" Foreground="Gray" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,0,0,4"/>
            <Button Content="Test Login" Command="{Binding TestLoginCommand}"
                    Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,15"/>

            <!-- Save -->
            <Button Content="Salva Impostazioni" Command="{Binding SaveCommand}"
                    Padding="12,6" Background="#0078D4" Foreground="White"
                    FontWeight="Bold" HorizontalAlignment="Left" Margin="0,10,0,10"/>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="#0af" Margin="0,5,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
