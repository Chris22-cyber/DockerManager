<Window x:Class="DockerManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DockerManager.App.Views"
        xmlns:converters="clr-namespace:DockerManager.App.Converters"
        Title="Docker Manager" Height="700" Width="1050"
        MinHeight="450" MinWidth="650"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/logo.ico">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceLowest}" Padding="0">
            <DockPanel>
                <!-- Logo + Title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,6">
                    <Image Source="/Resources/logo.png" Height="28" Width="28" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Docker Manager" FontFamily="Segoe UI Semibold" FontSize="15"
                               Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Menu VerticalAlignment="Center" Background="Transparent"
                      Foreground="{DynamicResource OnSurface}">
                    <MenuItem Header="File">
                        <MenuItem Header="Nuovo Progetto" Click="NewProject_Click"/>
                        <Separator/>
                        <MenuItem Header="Importa Progetto..." Click="ImportProject_Click"/>
                        <MenuItem Header="Esporta Progetto..." Click="ExportProject_Click"/>
                        <Separator/>
                        <MenuItem Header="Esci" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="Impostazioni" Click="Settings_Click"/>
                    <MenuItem Header="Help">
                        <MenuItem Header="Informazioni su Docker Manager" Click="About_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PrimaryGradient}" Padding="12,5">
            <TextBlock Text="{Binding StatusBarText}" Foreground="White" FontSize="12"/>
        </Border>

        <!-- Main Content -->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Top: Projects + Detail -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- Project List -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerLow}">
                    <views:ProjectListView DataContext="{Binding ProjectList}"/>
                </Border>

                <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource SurfaceContainerHigh}"
                              HorizontalAlignment="Stretch"/>

                <!-- Project Detail -->
                <views:ProjectDetailView Grid.Column="2"
                                         DataContext="{Binding ProjectDetail}"/>
            </Grid>

            <GridSplitter Grid.Row="1" Height="1" Background="{DynamicResource SurfaceContainerHigh}"
                          HorizontalAlignment="Stretch"/>

            <!-- Log Output -->
            <views:LogOutputView Grid.Row="2"
                                 DataContext="{Binding LogOutput}"/>
        </Grid>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,8">
                    <TextBlock Text="Impostazioni" FontSize="20" FontFamily="Segoe UI Semibold"
                               Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center"/>
                    <Button Content="Chiudi" Click="CloseSettings_Click"
                            Style="{StaticResource TertiaryButton}"
                            HorizontalAlignment="Right"/>
                </DockPanel>
                <views:SettingsView DataContext="{Binding Settings}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
