<Window x:Class="DockerManager.App.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progetto" Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D2D">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annulla" Click="Cancel_Click" Padding="16,6" Margin="4"/>
            <Button Content="Salva" Click="Save_Click" Padding="16,6" Margin="4"
                    Background="#0078D4" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nome Progetto"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Percorso Dockerfile"/>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="..." DockPanel.Dock="Right" Click="BrowseDockerfile_Click"
                            Padding="8,4" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding DockerfilePath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0"/>
                </DockPanel>

                <TextBlock Text="Directory Contesto"/>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="..." DockPanel.Dock="Right" Click="BrowseContext_Click"
                            Padding="8,4" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding ContextDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0"/>
                </DockPanel>

                <TextBlock Text="Nome Immagine"/>
                <TextBox Text="{Binding ImageName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Registry (es. docker.io/username)"/>
                <TextBox Text="{Binding Registry, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tags"/>
                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,0,0,5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#333" CornerRadius="3" Padding="6,2" Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" Foreground="#0af" VerticalAlignment="Center"/>
                                    <Button Content="x" Margin="6,0,0,0" FontSize="10"
                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="Aggiungi" DockPanel.Dock="Right"
                            Command="{Binding AddTagCommand}"
                            Padding="8,4" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
