<UserControl x:Class="DockerManager.App.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DockerManager.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <!-- No project selected -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Image Source="/Resources/logo.png" Height="64" Width="64" Opacity="0.3" Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Seleziona un progetto o creane uno nuovo"
                       Foreground="{DynamicResource OnSurfaceVariant}" FontSize="14"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Project detail -->
        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">

            <!-- Action buttons -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceContainerLow}"
                    CornerRadius="12" Padding="10,8" Margin="0,16,0,0">
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Build All" Command="{Binding BuildAllCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="3,3"/>
                    <Button Content="Build Selezionate" Command="{Binding BuildSelectedCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="3,3"/>
                    <Button Content="Push All" Command="{Binding PushAllCommand}"
                            Style="{StaticResource DangerButton}" Margin="3,3"/>
                    <Button Content="Push Selezionate" Command="{Binding PushSelectedCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="3,3"/>
                    <Button Content="Deploy All" Command="{Binding DeployCommand}"
                            Margin="3,3"
                            Visibility="{Binding HasDeployment, Converter={StaticResource BoolToVis}}"
                            Background="#107C10" Foreground="White" FontFamily="Segoe UI Semibold"
                            Padding="16,8" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Build &amp; Deploy" Command="{Binding BuildAndDeployCommand}"
                            Margin="3,3"
                            Visibility="{Binding HasDeployment, Converter={StaticResource BoolToVis}}"
                            Background="#107C10" Foreground="White" FontFamily="Segoe UI Semibold"
                            Padding="16,8" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Annulla" Command="{Binding CancelCommand}"
                            Style="{StaticResource TertiaryButton}" Margin="3,3"/>
                </WrapPanel>
            </Border>

            <!-- Project info -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="Modifica" Command="{Binding EditProjectCommand}"
                                Style="{StaticResource TertiaryButton}"
                                DockPanel.Dock="Right" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding CurrentProject.Name}" FontSize="22"
                                   FontFamily="Segoe UI Semibold"
                                   Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Info card -->
                    <Border Background="{DynamicResource SurfaceLowest}" CornerRadius="10"
                            Padding="20,16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Root Directory"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentProject.RootDirectory}"
                                       Foreground="{DynamicResource OnSurface}" Margin="0,4"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Descrizione"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentProject.Description}"
                                       Foreground="{DynamicResource OnSurface}" Margin="0,4"
                                       TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Server"
                                       Foreground="{DynamicResource OnSurfaceVariant}" Margin="0,4"
                                       Visibility="{Binding HasDeployment, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeployServerInfo}"
                                       Foreground="{DynamicResource OnSurface}" Margin="0,4"
                                       Visibility="{Binding HasDeployment, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Images list header -->
                    <TextBlock Text="Immagini" FontSize="15" FontFamily="Segoe UI Semibold"
                               Foreground="{DynamicResource OnSurface}" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding Images}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceLowest}" CornerRadius="8"
                                        Padding="14,10" Margin="0,3">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Image.Name}"
                                                       Foreground="{DynamicResource OnSurface}"
                                                       FontFamily="Segoe UI Semibold" FontSize="13"/>
                                            <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource OnSurfaceVariant}" FontSize="11">
                                                <Run Text="{Binding Image.ImageName, Mode=OneWay}"/>
                                                <Run Text=" | " Foreground="{DynamicResource OutlineVariant}"/>
                                                <Run Text="{Binding Image.DockerfilePath, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Image.Tags}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource PrimaryFixed}"
                                                                CornerRadius="10" Padding="8,2" Margin="2,0">
                                                            <TextBlock Text="{Binding}"
                                                                       Foreground="{DynamicResource Primary}" FontSize="10"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Progress -->
                    <Border CornerRadius="2" Margin="0,12,0,0" ClipToBounds="True"
                            Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="{Binding IsOperationRunning}"
                                     Height="4" Foreground="{DynamicResource Primary}"
                                     Background="{DynamicResource SurfaceContainerHigh}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
