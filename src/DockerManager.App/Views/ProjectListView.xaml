<UserControl x:Class="DockerManager.App.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
            <Button Content="+ Nuovo Progetto"
                    Command="{Binding AddProjectCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,4,0,0"/>
            <Button Content="Rimuovi"
                    Command="{Binding RemoveProjectCommand}"
                    Style="{StaticResource DangerButton}"
                    Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Text="Progetti" FontFamily="Segoe UI Semibold" FontSize="13"
                   Foreground="{DynamicResource OnSurfaceVariant}"
                   Margin="12,12,12,6"/>

        <ListBox ItemsSource="{Binding Projects}"
                 SelectedItem="{Binding SelectedProject}"
                 Margin="4"
                 Background="Transparent"
                 Foreground="{DynamicResource OnSurface}"
                 BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Margin" Value="4,1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource SurfaceContainerHigh}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource SurfaceLowest}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
                                   FontSize="13" Foreground="{DynamicResource OnSurface}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource OnSurfaceVariant}">
                            <Run Text="{Binding Images.Count, Mode=OneWay}"/>
                            <Run Text=" immagini"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
