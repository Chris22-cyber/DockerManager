<Window x:Class="DockerManager.App.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progetto" Height="750" Width="620"
        MinHeight="450" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI">

    <DockPanel Margin="24">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annulla" Click="Cancel_Click"
                    Style="{StaticResource TertiaryButton}" Margin="4,0"/>
            <Button Content="Salva" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" Margin="4,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nome Progetto" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Descrizione" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Root Directory" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,16">
                    <Button Content="Sfoglia" DockPanel.Dock="Right" Click="BrowseRootDirectory_Click"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Padding="14,8"/>
                    <TextBox Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"/>
                </DockPanel>

                <!-- Images section -->
                <DockPanel Margin="0,8,0,10">
                    <TextBlock Text="Immagini Docker" FontSize="15" FontFamily="Segoe UI Semibold"
                               Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center"/>
                    <Button Content="+ Aggiungi Immagine" HorizontalAlignment="Right"
                            Command="{Binding AddImageCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="14,6"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Images}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceLowest}" CornerRadius="8"
                                    Padding="14,10" Margin="0,3">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Modifica" Margin="4,0"
                                                Command="{Binding DataContext.EditImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TertiaryButton}" Padding="8,4"/>
                                        <Button Content="Rimuovi"
                                                Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}" Padding="8,4"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
                                                   Foreground="{DynamicResource OnSurface}"/>
                                        <TextBlock Foreground="{DynamicResource OnSurfaceVariant}" FontSize="11">
                                            <Run Text="{Binding ImageName, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding DockerfilePath, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Deployment SSH section -->
                <Separator Margin="0,12,0,12" Background="{DynamicResource OutlineVariant}"/>

                <TextBlock Text="Deployment SSH" FontSize="15" FontFamily="Segoe UI Semibold"
                           Foreground="{DynamicResource OnSurface}" Margin="0,0,0,10"/>

                <!-- Profile selector -->
                <TextBlock Text="Profilo Server" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding AvailableProfiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,4"
                          Background="{DynamicResource SurfaceContainerHigh}"
                          Foreground="{DynamicResource OnSurface}"/>
                <TextBlock Text="Seleziona un profilo oppure configura manualmente qui sotto"
                           Foreground="{DynamicResource OnSurfaceVariant}" FontSize="11" Margin="0,0,0,10"/>

                <StackPanel IsEnabled="{Binding IsManualConfig}">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host"
                                   Foreground="{DynamicResource OnSurfaceVariant}" FontSize="12" Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Porta"
                                   Foreground="{DynamicResource OnSurfaceVariant}" FontSize="12" Margin="0,0,0,4"/>

                        <TextBox Grid.Row="1" Grid.Column="0"
                                 Text="{Binding DeployHost, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBox}" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding DeployPort, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBox}" Margin="0,0,0,8"/>
                    </Grid>

                    <TextBlock Text="Username" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DeployUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}" Margin="0,0,0,8"/>

                    <TextBlock Text="Password" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="DeployPasswordBox"
                                 Margin="0,0,0,8" Padding="8,8"
                                 Background="{DynamicResource SurfaceContainerHigh}"
                                 Foreground="{DynamicResource OnSurface}"
                                 BorderBrush="{DynamicResource Outline}" BorderThickness="1"/>

                    <TextBlock Text="Working Directory" Foreground="{DynamicResource OnSurfaceVariant}"
                               FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DeployWorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}" Margin="0,0,0,8"/>

                    <CheckBox Content="Usa sudo" IsChecked="{Binding DeployUseSudo}"
                              Foreground="{DynamicResource OnSurface}" Margin="0,0,0,12"/>

                    <!-- Test Connection -->
                    <DockPanel Margin="0,0,0,8">
                        <Button Content="Test Connessione" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="14,6"
                                DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding TestConnectionStatus}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnSurfaceVariant}" Margin="12,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
