<Window x:Class="DockerManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DockerManager.App.Views"
        xmlns:converters="clr-namespace:DockerManager.App.Converters"
        Title="Docker Manager" Height="700" Width="1050"
        MinHeight="500" MinWidth="800"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#2D2D2D" Foreground="White">
            <MenuItem Header="File">
                <MenuItem Header="Nuovo Progetto" Click="NewProject_Click"/>
                <Separator/>
                <MenuItem Header="Esci" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Impostazioni" Click="Settings_Click"/>
            <MenuItem Header="Help">
                <MenuItem Header="Informazioni su Docker Manager" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#007ACC">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="200" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Top: Projects + Detail -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="150"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- Project List -->
                <views:ProjectListView Grid.Column="0"
                                       DataContext="{Binding ProjectList}"/>

                <GridSplitter Grid.Column="1" Width="5" Background="#333"
                              HorizontalAlignment="Stretch"/>

                <!-- Project Detail -->
                <views:ProjectDetailView Grid.Column="2"
                                         DataContext="{Binding ProjectDetail}"/>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" Background="#333"
                          HorizontalAlignment="Stretch"/>

            <!-- Log Output -->
            <views:LogOutputView Grid.Row="2"
                                 DataContext="{Binding LogOutput}"/>
        </Grid>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#2D2D2D">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,5">
                    <Button Content="Chiudi" Click="CloseSettings_Click"
                            HorizontalAlignment="Right" Padding="8,4"/>
                </DockPanel>
                <views:SettingsView DataContext="{Binding Settings}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
