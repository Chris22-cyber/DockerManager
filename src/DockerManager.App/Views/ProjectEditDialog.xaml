<Window x:Class="DockerManager.App.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Progetto" Height="580" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource OnSurface}"
        FontFamily="Segoe UI">

    <DockPanel Margin="24">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annulla" Click="Cancel_Click"
                    Style="{StaticResource TertiaryButton}" Margin="4,0"/>
            <Button Content="Salva" Click="Save_Click"
                    Style="{StaticResource PrimaryButton}" Margin="4,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nome Progetto" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Descrizione" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="Root Directory" Foreground="{DynamicResource OnSurfaceVariant}"
                           FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,16">
                    <Button Content="Sfoglia" DockPanel.Dock="Right" Click="BrowseRootDirectory_Click"
                            Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Padding="14,8"/>
                    <TextBox Text="{Binding RootDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBox}"/>
                </DockPanel>

                <!-- Images section -->
                <DockPanel Margin="0,8,0,10">
                    <TextBlock Text="Immagini Docker" FontSize="15" FontFamily="Segoe UI Semibold"
                               Foreground="{DynamicResource OnSurface}" VerticalAlignment="Center"/>
                    <Button Content="+ Aggiungi Immagine" HorizontalAlignment="Right"
                            Command="{Binding AddImageCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="14,6"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Images}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceLowest}" CornerRadius="8"
                                    Padding="14,10" Margin="0,3">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Modifica" Margin="4,0"
                                                Command="{Binding DataContext.EditImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TertiaryButton}" Padding="8,4"/>
                                        <Button Content="Rimuovi"
                                                Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}" Padding="8,4"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold"
                                                   Foreground="{DynamicResource OnSurface}"/>
                                        <TextBlock Foreground="{DynamicResource OnSurfaceVariant}" FontSize="11">
                                            <Run Text="{Binding ImageName, Mode=OneWay}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding DockerfilePath, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
