<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Surface Hierarchy (Light Theme - Architectural Tech-Optimism) -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <Color x:Key="SurfaceLowestColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#F7F9FB</Color>
    <Color x:Key="SurfaceContainerLowColor">#F2F4F6</Color>
    <Color x:Key="SurfaceContainerHighColor">#E6E8EA</Color>
    <Color x:Key="SurfaceContainerHighestColor">#DADDE0</Color>

    <SolidColorBrush x:Key="SurfaceLowest" Color="{StaticResource SurfaceLowestColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerLow" Color="{StaticResource SurfaceContainerLowColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHigh" Color="{StaticResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighest" Color="{StaticResource SurfaceContainerHighestColor}"/>

    <!-- Primary Blues -->
    <Color x:Key="PrimaryColor">#003EC7</Color>
    <Color x:Key="PrimaryContainerColor">#0052FF</Color>
    <Color x:Key="PrimaryFixedColor">#E8EEFF</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="OnPrimaryContainerColor">#001A6B</Color>

    <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryContainer" Color="{StaticResource PrimaryContainerColor}"/>
    <SolidColorBrush x:Key="PrimaryFixed" Color="{StaticResource PrimaryFixedColor}"/>
    <SolidColorBrush x:Key="OnPrimary" Color="{StaticResource OnPrimaryColor}"/>
    <SolidColorBrush x:Key="OnPrimaryContainer" Color="{StaticResource OnPrimaryContainerColor}"/>

    <!-- Secondary Blues -->
    <Color x:Key="SecondaryContainerColor">#D6E3FF</Color>
    <Color x:Key="OnSecondaryContainerColor">#1B2D5A</Color>

    <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}"/>
    <SolidColorBrush x:Key="OnSecondaryContainer" Color="{StaticResource OnSecondaryContainerColor}"/>

    <!-- Text & On-Surface -->
    <Color x:Key="OnSurfaceColor">#191C1E</Color>
    <Color x:Key="OnSurfaceVariantColor">#44474E</Color>
    <Color x:Key="OutlineVariantColor">#C4C6CF</Color>

    <SolidColorBrush x:Key="OnSurface" Color="{StaticResource OnSurfaceColor}"/>
    <SolidColorBrush x:Key="OnSurfaceVariant" Color="{StaticResource OnSurfaceVariantColor}"/>
    <SolidColorBrush x:Key="OutlineVariant" Color="{StaticResource OutlineVariantColor}"/>

    <!-- Accent Colors -->
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="ErrorColor">#BA1A1A</Color>
    <Color x:Key="ErrorContainerColor">#FFDAD6</Color>
    <Color x:Key="WarningColor">#C87000</Color>

    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorContainer" Color="{StaticResource ErrorContainerColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>

    <!-- Signature Gradient -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryContainerColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Status Bar Gradient -->
    <LinearGradientBrush x:Key="StatusBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
        <GradientStop Color="#0060E0" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Typography -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <FontFamily x:Key="HeadlineFont">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Global Styles -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- Window -->
    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>

    <!-- Primary Button (Gradient) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SecondaryContainer}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tertiary Button (Text-only) -->
    <Style x:Key="TertiaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceContainerLow}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Error}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource HeadlineFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Styled TextBox (No border, tonal background) -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceContainerHigh}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurface}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceLowest}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Bd" Property="Padding" Value="8,6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Surface -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceLowest}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Tag Chip -->
    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryFixed}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

</ResourceDictionary>
