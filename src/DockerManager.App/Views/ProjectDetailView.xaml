<UserControl x:Class="DockerManager.App.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DockerManager.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <!-- No project selected -->
        <TextBlock Text="Seleziona un progetto o creane uno nuovo"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="Gray" FontSize="14"
                   Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

        <!-- Project detail -->
        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">

            <!-- Action buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Build" Command="{Binding BuildCommand}"
                        Padding="16,6" Margin="4" MinWidth="80"
                        Background="#0078D4" Foreground="White" FontWeight="Bold"/>
                <Button Content="Tag" Command="{Binding TagCommand}"
                        Padding="16,6" Margin="4" MinWidth="80"
                        Background="#107C10" Foreground="White" FontWeight="Bold"/>
                <Button Content="Push" Command="{Binding PushCommand}"
                        Padding="16,6" Margin="4" MinWidth="80"
                        Background="#E81123" Foreground="White" FontWeight="Bold"/>
                <Button Content="Annulla" Command="{Binding CancelCommand}"
                        Padding="16,6" Margin="4" MinWidth="80"/>
            </StackPanel>

            <!-- Project info -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Progetto" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="Modifica" Command="{Binding EditProjectCommand}"
                                HorizontalAlignment="Right" Padding="8,3"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome:" Foreground="Gray" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentProject.Name}"
                                   Foreground="White" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dockerfile:" Foreground="Gray" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentProject.DockerfilePath}"
                                   Foreground="White" Margin="0,4" TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Immagine:" Foreground="Gray" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProject.ImageName}"
                                   Foreground="White" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Registry:" Foreground="Gray" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentProject.Registry}"
                                   Foreground="White" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Tag:" Foreground="Gray" Margin="0,4"/>
                        <ItemsControl Grid.Row="4" Grid.Column="1"
                                      ItemsSource="{Binding CurrentProject.DefaultTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#333" CornerRadius="3" Padding="6,2" Margin="2">
                                        <TextBlock Text="{Binding}" Foreground="#0af"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Tag selector for operations -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Tag operazione:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding CurrentProject.DefaultTags}"
                                  SelectedItem="{Binding SelectedTag}"
                                  IsEditable="True"
                                  MinWidth="150"/>
                    </StackPanel>

                    <!-- Progress -->
                    <ProgressBar IsIndeterminate="{Binding IsOperationRunning}"
                                 Height="4" Margin="0,10,0,0"
                                 Visibility="{Binding IsOperationRunning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
